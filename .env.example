# --- Frontend ---
# URL base de la API que consume el frontend (se inyecta en el build de Vite)
VITE_API_URL=http://localhost:4000/api
# true: el frontend usa los datos locales de data/; false: llama al backend
VITE_USE_MOCKS=false

# Puerto local donde se publica el frontend
FRONTEND_PORT=8080

# --- Backend ---
PORT=4000
# En docker compose se usa mongodb://mongo:27017/proshop
MONGO_URI=mongodb://localhost:27017/proshop
# Único origen aceptado por CORS
FRONTEND_URL=http://localhost:8080
NODE_ENV=development
# Swagger UI en /api/docs: siempre activo fuera de producción; en producción solo si es true
ENABLE_DOCS=false
